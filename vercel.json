{
  "version": 2,
  "functions": {
    "api/get.py": {
      "runtime": "python3.12",
      "memory": 1024,
      "maxDuration": 60
    },
    "api/session.py": {
      "runtime": "python3.12",
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/get",
      "destination": "/api/get"
    },
    {
      "source": "/session",
      "destination": "/api/session"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
